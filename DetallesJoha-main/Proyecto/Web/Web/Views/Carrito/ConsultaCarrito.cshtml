@model List<Web.Models.CarritoProductoViewModel>
@{
    ViewBag.Title = "Mi Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isUserLoggedIn = Session["Consecutivo"] != null;    
}

<div class="shopping-cart-container">
    <div class="cart-header">
        <h2>Mi Carrito de Compras</h2>
    </div>

    @if (ViewBag.MsjPantalla != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.MsjPantalla
        </div>
    }

    <div class="cart-content">
        @if (Model != null && Model.Any())
        {
            <div class="cart-items">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        <div class="item-image">
                            @if (!string.IsNullOrEmpty(item.CarritoItem.RutaDiseno))
                            {
                                <img src="@item.CarritoItem.RutaDiseno" alt="Diseño personalizado" style="max-width:200px;" />
                            }
                            else
                            {
                             <img src="@item.ProductoItem.RutaImagen" alt="@item.ProductoItem.NombreProducto"
                                     onerror="this.src='/img/default-product.png'">
                            }

                        </div>
                        <div class="item-details">
                            <h3 class="item-name">@item.ProductoItem.NombreProducto</h3>
                            <div class="item-price">
                                @if (item.ProductoItem.En_promocion)
                                {
                                    <span class="original-price">₡@item.ProductoItem.Precio.ToString("N2")</span>
                                    <span class="discount-price">₡@item.ProductoItem.PrecioConDescuento.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="price">₡@item.ProductoItem.Precio.ToString("N2")</span>
                                }
                            </div>
                            <div class="quantity-controls">
                                <button class="quantity-btn minus" data-id="@item.CarritoItem.ConsecutivoCarrito">-</button>
                                <input type="number" class="quantity-input" value="@item.CarritoItem.Cantidad"
                                       min="1" max="99" data-id="@item.CarritoItem.ConsecutivoCarrito">
                                <button class="quantity-btn plus" data-id="@item.CarritoItem.ConsecutivoCarrito">+</button>
                            </div>
                        </div>
                        <div class="item-totals">
                            <div class="item-subtotal">
                                Subtotal: ₡@item.CarritoItem.SubTotal.ToString("N2")
                            </div>
                            <div class="item-iva">
                                IVA: ₡@item.CarritoItem.Impuesto.ToString("N2")
                            </div>
                            <div class="item-total">
                                Total: ₡@item.CarritoItem.Total.ToString("N2")
                            </div>
                        </div>
                        <button class="remove-item" data-toggle="modal" data-target="#modalEliminar"
                                data-id="@item.CarritoItem.ConsecutivoCarrito">
                            <i class="fa fa-trash" tittle="Eliminar"></i>
                        </button>
                    </div>
                }
            </div>

            if (isUserLoggedIn)
            {
                <div class="cart-summary">
                    <div class="summary-header">
                        <h3>Resumen del Pedido</h3>
                    </div>
                    <div class="summary-details">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>₡@Session["SubTotal"].ToString()</span>
                        </div>
                        <div class="summary-row">
                            <span>IVA (13%)</span>
                            <span>₡@((Session["IVA"] != null ? Session["IVA"].ToString() : "N2"))</span>
                        </div>
                        <div class="summary-total">
                            <span>Total</span>
                            <span>₡@((Session["Total"] != null ? Session["Total"].ToString() : "N2"))</span>
                        </div>
                    </div>

                    <div class="payment-options">
                        <h4>Método de Pago</h4>
                        <div class="payment-method">
                            <input type="radio" id="sinpe" name="payment" required>
                            <label for="sinpe">
                                <span class="radio-custom"></span>
                                Sinpe Móvil
                            </label>
                            <div class="payment-details">
                                <p>Número: 8303-9384</p>
                                <small>Favor compartir comprobante al mismo número</small>
                            </div>
                        </div>

                        <div class="payment-method">
                            <input type="radio" id="paypal" name="payment" required>
                            <label for="paypal">
                                <span class="radio-custom"></span>
                                PayPal
                            </label>
                        </div>
                    </div>

                    <div class="terms-agreement">
                        <label>
                            <input type="checkbox" id="terms" required>
                            <span class="checkbox-custom"></span>
                            He leído y acepto los <a href="#">Términos y Condiciones</a>
                        </label>
                    </div>


                    @using (Html.BeginForm("PagarCarrito", "Carrito", FormMethod.Post))
                    {
                        <button type="submit" class="checkout-button" id="btnPagar" disabled>
                            Proceder al Pago
                            <i class="fa fa-arrow-right"></i>
                        </button>
                    }
                </div>
            }
            else
            {
                <!-- SI NO ESTÁ LOGUEADO: Mostrar un bloque invitando a iniciar sesión -->
                <div class="cart-summary">
                    <h3>¿Quieres finalizar la compra?</h3>
                    <p>Para ver el resumen y proceder al pago, debes iniciar sesión.</p>
                    <div style="margin-top: 1.5rem;">
                        <a href="@Url.Action("IniciarSesion", "Inicio", new { ReturnUrl = Request.Url })" class="continue-shopping">
                            Continuar con la compra
                        </a>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-cart">
                <i class="fa fa-shopping-cart fa-4x"></i>
                <h3>Tu carrito está vacío</h3>
                <p>¡Agrega algunos productos para comenzar!</p>
                <a href="@Url.Action("PantallaPrincipal", "Inicio")" class="continue-shopping">
                    Comenzar a Comprar
                </a>
            </div>
        }
    </div>
</div>


<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                ¿Está seguro que desea eliminar este producto del carrito?
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("EliminarCarrito", "Carrito", FormMethod.Post))
                {
                    <input type="hidden" id="ConsecutivoCarrito" name="ConsecutivoCarrito" value="" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .shopping-cart-container {
        max-width: 1300px;
        margin: 3rem auto;
        padding: 0 1.5rem;
    }

    .cart-header {
        text-align: center;
        margin-bottom: 3rem;
    }

        .cart-header h2 {
            color: #dc3545;
            font-size: 2.5rem;
            font-weight: 700;
        }

    .cart-content {
        display: flex;
        gap: 2.5rem;
        flex-wrap: wrap;
    }

    .cart-items {
        flex: 1;
        min-width: 350px;
    }

    .cart-item {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 3px 6px rgba(0,0,0,0.15);
        display: flex;
        position: relative;
        gap: 2rem;
    }

    .item-image {
        width: 150px;
        height: 150px;
    }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 6px;
        }

    .item-details {
        flex: 1;
    }

    .item-name {
        font-size: 1.5rem;
        margin: 0 0 0.8rem 0;
        color: #333;
        font-weight: 600;
    }

    .item-price {
        margin-bottom: 1.5rem;
    }

    .original-price {
        color: #999;
        text-decoration: line-through;
        margin-right: 0.8rem;
        font-size: 1.2rem;
    }

    .discount-price, .price {
        color: #dc3545;
        font-weight: bold;
        font-size: 1.4rem;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-top: 1.5rem;
    }

    .quantity-btn {
        width: 38px;
        height: 38px;
        border: none;
        background: #f8f9fa;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        color: #dc3545;
        font-size: 1.2rem;
    }

        .quantity-btn:hover {
            background: #e9ecef;
        }

    .quantity-input {
        width: 60px;
        height: 38px;
        text-align: center;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 1.2rem;
    }

    .item-totals {
        min-width: 180px;
        text-align: right;
    }

    .item-subtotal, .item-iva {
        color: #666;
        font-size: 1.1rem;
        margin-bottom: 0.8rem;
    }

    .item-total {
        color: #dc3545;
        font-weight: bold;
        font-size: 1.4rem;
    }

    .remove-item {
        background: none;
        border: none;
        color: #dc3545;
        cursor: pointer;
        font-size: 2rem;
        margin-top: 12rem; 
    }


    .cart-summary {
        width: 400px;
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 3px 6px rgba(0,0,0,0.15);
        align-self: flex-start;
        position: sticky;
        top: 2rem;
    }

    .summary-header h3 {
        margin: 0 0 2rem 0;
        color: #333;
        font-size: 1.6rem;
        font-weight: 600;
    }

    .summary-details {
        margin-bottom: 2.5rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.2rem;
        color: #666;
        font-size: 1.2rem;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid #eee;
        font-weight: bold;
        color: #dc3545;
        font-size: 1.5rem;
    }

    .payment-options {
        margin: 2.5rem 0;
    }

        .payment-options h4 {
            margin-bottom: 1.5rem;
            color: #333;
            font-size: 1.3rem;
        }

    .payment-method {
        margin-bottom: 1.5rem;
    }

        .payment-method label {
            display: flex;
            align-items: center;
            cursor: pointer;
            font-size: 1.2rem;
        }

    .radio-custom {
        width: 22px;
        height: 22px;
        border: 2px solid #dc3545;
        border-radius: 50%;
        margin-right: 0.8rem;
        position: relative;
    }

    .payment-method input[type="radio"] {
        display: none;
    }

        .payment-method input[type="radio"]:checked + label .radio-custom::after {
            content: '';
            width: 12px;
            height: 12px;
            background: #dc3545;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

    .payment-details {
        margin-left: 2rem;
        font-size: 1.1rem;
        color: #666;
    }

    .terms-agreement {
        margin: 2.5rem 0;
    }

        .terms-agreement label {
            display: flex;
            align-items: center;
            cursor: pointer;
            font-size: 1.1rem;
        }

    .checkbox-custom {
        width: 22px;
        height: 22px;
        border: 2px solid #dc3545;
        border-radius: 6px;
        margin-right: 0.8rem;
        position: relative;
    }

    .terms-agreement input[type="checkbox"] {
        display: none;
    }

        .terms-agreement input[type="checkbox"]:checked + .checkbox-custom::after {
            content: '\2714';
            color: #dc3545;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.2rem;
        }

    .checkout-button {
        width: 100%;
        padding: 1.2rem;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 1.3rem;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.8rem;
        transition: background-color 0.3s;
    }

        .checkout-button:hover {
            background: #c82333;
        }

        .checkout-button:disabled {
            background: #dc354580;
            cursor: not-allowed;
        }

    .empty-cart {
        width: 100%;
        text-align: center;
        padding: 4rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 3px 6px rgba(0,0,0,0.15);
    }

        .empty-cart i {
            color: #dc3545;
            margin-bottom: 1.5rem;
            font-size: 3rem;
        }

        .empty-cart h3 {
            color: #333;
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
        }

    .continue-shopping {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 1rem 2rem;
        background: #dc3545;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 1.2rem;
        transition: background-color 0.3s;
    }

        .continue-shopping:hover {
            background: #c82333;
            color: white;
            text-decoration: none;
        }
</style>

<script>
    $(document).ready(function () {
        $('.quantity-btn').click(function() {
            var input = $(this).siblings('.quantity-input');
            var currentValue = parseInt(input.val());

            if ($(this).hasClass('plus')) {
                if (currentValue < 99) input.val(currentValue + 1);
            } else {
                if (currentValue > 1) input.val(currentValue - 1);
            }
            actualizarCantidad(input);
        });

        $('.quantity-input').change(function() {
            actualizarCantidad($(this));
        });

        function actualizarCantidad(input) {
            var id = input.data('id');
            var cantidad = input.val();

            $.ajax({
                url: '@Url.Action("ActualizarCantidad", "Carrito")',
                type: 'POST',
                data: { consecutivoCarrito: id, cantidad: cantidad },
                success: function(result) {
                    if (result.success) {
                        location.reload();
                    }
                }
            });
        }

        $('input[name="payment"], #terms').on('change', function () {
            actualizarBotonPago();
        });

        actualizarBotonPago();

        function actualizarBotonPago() {
            var pagoSeleccionado = $('input[name="payment"]:checked').length > 0;
            var terminosAceptados = $('#terms').is(':checked');
            console.log("Pago seleccionado: ", pagoSeleccionado, "Términos aceptados: ", terminosAceptados);
            $('#btnPagar').prop('disabled', !(pagoSeleccionado && terminosAceptados));
        }

        $('#modalEliminar').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);

            var consecutivoCarrito = button.data('id');

            $(this).find('#ConsecutivoCarrito').val(consecutivoCarrito);
        });

    });
</script>
