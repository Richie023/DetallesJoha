@model Web.Entidades.PoliticaDevolucion
@{
    ViewBag.Title = "Insertar";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="container mt-5">
    <h3 class="text-center font-weight-bold">Registrar Política de Devolución</h3>

    @using (Html.BeginForm("Insertar", "PoliticaDevolucion", FormMethod.Post))
    {
        <div class="form-group">
            <label for="titulo_seccion">Título</label>
            @Html.TextBoxFor(model => model.titulo_seccion, new { @class = "form-control", @placeholder = "Título de la Sección" })
        </div>
        <div class="form-group">
            <label for="contenido">Contenido</label>
            @Html.TextAreaFor(model => model.contenido, new
            {
                @class = "form-control",
                @placeholder = "Cada línea se convertirá en una viñeta al guardar"
            })
        </div>
        <div class="text-right">
            <button type="submit" class="primary-btn">Guardar</button>
            <a href="@Url.Action("PoliticaDevolucion", "PoliticaDevolucion")" class="primary-btn">Cancelar</a>
        </div>


    }
    <!-- Muestra un mensaje de error o confirmación si lo hay -->
    @if (!string.IsNullOrEmpty(ViewBag.MsjPantalla as string))
    {
        <div class="alert alert-warning mt-3">
            @ViewBag.MsjPantalla
        </div>
    }
</div>
