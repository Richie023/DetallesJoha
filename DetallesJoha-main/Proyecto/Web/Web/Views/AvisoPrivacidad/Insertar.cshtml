@model Web.Entidades.AvisoPrivacidad

@{
    ViewBag.Title = "Registrar Aviso de Privacidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="politicas-container">
    <div class="politicas-header">
        <h3>Registrar Aviso de Privacidad</h3>
        <h4>Escribe el título y el contenido en forma de lista (una línea por punto).</h4>
    </div>

    @using (Html.BeginForm("Insertar", "AvisoPrivacidad", FormMethod.Post))
    {
        <div class="form-group mb-4">
            <label for="titulo_seccion" class="font-weight-bold">Título del Aviso</label>
            @Html.TextBoxFor(model => model.titulo_seccion, new { @class = "form-control", @placeholder = "Ej. Tratamiento de Datos Personales" })
        </div>

        <div class="form-group mb-4">
            <label for="contenido" class="font-weight-bold">Contenido</label>
            @Html.TextAreaFor(model => model.contenido, new
            {
                @class = "form-control",
                rows = "8",
                @placeholder = "Escribe cada punto en una línea. Se convertirá automáticamente en una lista con viñetas."
            })
        </div>

        <div class="text-right">
            <button type="submit" class="primary-btn bg-success text-white">Guardar</button>
            <a href="@Url.Action("AvisoPrivacidad", "AvisoPrivacidad")" class="primary-btn bg-secondary text-white">Cancelar</a>
        </div>
    }

    @if (ViewBag.MsjPantalla != null)
    {
        <div class="alert alert-danger mt-4 text-center">
            @ViewBag.MsjPantalla
        </div>
    }
</div>
