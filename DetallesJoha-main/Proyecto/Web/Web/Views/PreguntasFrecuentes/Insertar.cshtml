@model Web.Entidades.PreguntasFrecuentes

@{
    ViewBag.Title = "Registrar Pregunta Frecuente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="faq-container">
    <div class="faq-header">
        <h3>Registrar Pregunta Frecuente</h3>
        <h4>Escribe una respuesta clara. Puedes usar viñetas escribiendo cada punto en una línea.</h4>
    </div>

    @using (Html.BeginForm("Insertar", "PreguntasFrecuentes", FormMethod.Post))
    {
        <div class="form-group mb-4">
            <label for="pregunta" class="font-weight-bold">Pregunta</label>
            @Html.TextBoxFor(model => model.pregunta, new
            {
                @class = "form-control",
                @placeholder = "Ej. ¿Cómo actualizo mi perfil?"
            })
        </div>

        <div class="form-group mb-4">
            <label for="respuesta" class="font-weight-bold">Respuesta</label>
            @Html.TextAreaFor(model => model.respuesta, new
            {
                @class = "form-control",
                rows = "7",
                @placeholder = "Escribe cada punto en una línea. Al guardar se mostrará como lista de viñetas."
            })
        </div>

        <div class="text-right">
            <button type="submit" class="primary-btn bg-success text-white">Guardar</button>
            <a href="@Url.Action("PreguntasFrecuentes", "PreguntasFrecuentes")" class="primary-btn bg-secondary text-white">Cancelar</a>
        </div>
    }

    @if (ViewBag.MsjPantalla != null)
    {
        <div class="alert alert-danger mt-4 text-center">
            @ViewBag.MsjPantalla
        </div>
    }
</div>
