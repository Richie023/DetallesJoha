@model Web.Entidades.BlogArticulo

@{
    ViewBag.Title = "Editar Artículo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center font-weight-bold">Editar Artículo</h2>
    <h3 class="text-center text-muted">Modifica el contenido del artículo del blog y reemplaza la imagen si es necesario.</h3>

    @using (Html.BeginForm("Editar", "Blog", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(model => model.id)

        <div class="form-group mb-4">
            <label for="titulo" class="font-weight-bold">Título</label>
            @Html.TextBoxFor(model => model.titulo, new { @class = "form-control", @placeholder = "Título del artículo" })
        </div>

        <div class="form-group mb-4">
            <label for="resumen" class="font-weight-bold">Resumen</label>
            @Html.TextAreaFor(model => model.resumen, new
            {
                @class = "form-control",
                rows = "3",
                @placeholder = "Resumen breve del artículo"
            })
        </div>

        <div class="form-group mb-4">
            <label for="contenido" class="font-weight-bold">Contenido</label>
            @Html.TextAreaFor(model => model.contenido, new
            {
                @class = "form-control",
                rows = "8",
                @placeholder = "Contenido completo del artículo"
            })
        </div>

        <div class="form-group mb-4">
            <label for="ImagenBlog" class="font-weight-bold">Imagen</label>
            <div class="row align-items-center">
                <div class="col-md-8">
                    <input type="file" id="ImagenBlog" name="ImagenBlog" class="form-control" accept="image/*" onchange="previewImagen(this)">
                </div>
                <div class="col-md-4 text-center mt-3 mt-md-0">
                    @if (!string.IsNullOrEmpty(ViewBag.imagen_url))
                    {
                        <img id="imagenActual" src="@ViewBag.imagen_url" alt="Imagen actual" class="img-thumbnail mb-2" style="max-width: 120px;" />
                    }
                    else
                    {
                        <span>No hay imagen disponible</span>
                    }
                    <img id="previewImagen" src="#" alt="Vista previa" style="max-width: 120px; display: none;" class="img-thumbnail" />
                </div>
            </div>
        </div>

        <div class="text-right">
            <button type="submit" class="primary-btn bg-primary text-white">Actualizar</button>
            <a href="@Url.Action("Blog", "Blog")" class="primary-btn bg-secondary text-white">Cancelar</a>
        </div>
    }

    @if (ViewBag.MsjPantalla != null)
    {
        <div class="alert alert-danger mt-4 text-center">
            @ViewBag.MsjPantalla
        </div>
    }
</div>


<script>
    function previewImagen(input) {
        const preview = document.getElementById('previewImagen');
        const actual = document.getElementById('imagenActual');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                if (actual) actual.style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

