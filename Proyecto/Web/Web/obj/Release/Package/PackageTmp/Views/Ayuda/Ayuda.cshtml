@model List<Web.Entidades.Ayuda>

@{
    ViewBag.Title = "Ayuda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://stackpath.bootstrapcdn.com/bootswatch/5.1.3/cosmo/bootstrap.min.css" rel="stylesheet">



<div class="container mt-5">
    <h3 class="text-center font-weight-bold">Sección de Ayuda</h3>
    <h4 class="text-center text-muted">Encuentra respuestas a las preguntas más frecuentes y guías útiles.</h4>

    @if (Session["RolUsuario"] != null && Session["RolUsuario"].ToString() == "1")
    {
        <div class="text-right mt-4">
            <a href="@Url.Action("Insertar", "Ayuda")" class="primary-btn">Agregar Nueva Ayuda</a>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="accordion" id="helpAccordion">
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <div class="card">
                    <div class="card-header" id="heading-@i">
                        <h2 class="mb-0">
                            <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#collapse-@i" aria-expanded="true" aria-controls="collapse-@i">
                                @item.categoria
                            </button>
                        </h2>
                    </div>

                    <div id="collapse-@i" class="collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-@i" data-parent="#helpAccordion">
                        <div class="card-body">
                            <h4 class="card-title">@item.titulo</h4>
                            <p class="card-text">@item.contenido</p>
                            <div class="text-muted mb-3">@item.ultima_actualizacion.ToString()</div>
                            <div class="text-right">
                                @if (Session["RolUsuario"] != null && Session["RolUsuario"].ToString() == "1")
                                {
                                    <a href="@Url.Action("Editar", "Ayuda", new { id = @item.id })"><i class="fa fa-pencil-square-o fa-2x" title="Editar Ayuda"></i></a>
                                    <a href="@Url.Action("Eliminar", "Ayuda", new { id = @item.id })"><i class="fa fa-trash-o fa-2x" title="Eliminar Ayuda"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No se encontraron entradas de ayuda en este momento.
        </div>
    }
</div>