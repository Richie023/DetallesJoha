@model List<Web.Entidades.BlogArticulo>
@{
    ViewBag.Title = "Blog | Contenido Personalizado";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<!-- Hero Section -->
<section class="blog-hero">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <h1 class="blog-title">Blog</h1>
                <p class="blog-subtitle">Descubre los artículos más recientes y destacados de nuestro blog.</p>

                @if (Session["RolUsuario"] != null && Session["RolUsuario"].ToString() == "1")
                {
                    <div class="text-right mt-4">
                        <a href="@Url.Action("Insertar", "Blog")" class="primary-btn bg-danger text-white">Agregar Nuevo Blogs</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Articles Grid -->
<section class="blog-content">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="articles-grid">
                @foreach (var blog in Model)
                {
                    <article class="blog-card">
                        <div class="card-image">
                            @if (!string.IsNullOrEmpty(blog.imagen_url))
                            {
                                <div class="image-wrapper" style="background-image: url('@Url.Content(blog.imagen_url)');"></div>
                            }
                            else
                            {
                                <div class="image-placeholder">
                                    <i class="fa fa-image"></i>
                                </div>
                            }
                        </div>
                        <div class="card-content">
                            <div class="article-meta">
                                <span class="article-date">
                                    <i class="fa fa-calendar-o"></i>
                                    @blog.fecha_publicacion.ToString()
                                </span>
                            </div>
                            <h2 class="article-title">@blog.titulo</h2>
                            <p class="article-excerpt">@(blog.resumen.Length > 100 ? blog.resumen.Substring(0, 100) + "..." : blog.resumen)</p>

                            <div class="article-footer">
                                <a href="@Url.Action("Detalle", "Blog", new { id = @blog.id })" class="read-more">
                                    <span>Leer artículo</span>
                                    <i class="fa fa-arrow-right"></i>
                                </a>

                                @if (Session["RolUsuario"] != null && Session["RolUsuario"].ToString() == "1")
                                {
                                    <div class="admin-tools">
                                        <a href="@Url.Action("Editar", "Blog", new { id = @blog.id })" class="admin-btn edit" title="Editar">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a href="@Url.Action("Eliminar", "Blog", new { id = @blog.id })" class="admin-btn delete" title="Eliminar">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-blog">
                <div class="empty-icon">
                    <i class="fa fa-file-text-o"></i>
                </div>
                <h3>No hay artículos disponibles</h3>
                <p>Pronto publicaremos nuevo contenido. ¡Vuelve a visitarnos!</p>
            </div>
        }
    </div>
</section>

<style>
  
    /* Hero section */
    .blog-hero {
        max-width: 1140px;
        margin: 0 auto;
        padding: 1rem 1rem;
    }

        .blog-hero::after {
            position: absolute;
            width: 60px;
            height: 3px;
            background-color: #e74c3c;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
        }

    .blog-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 5px;
        color: var(--primary-color);
    }

    .blog-subtitle {
        font-size: 1.5rem;
        color: #6c757d;
        max-width: 600px;
        margin: 0 auto -50px;
    }

    /* Botón de agregar nueva política */
    .primary-btn {
        display: inline-block;
        padding: 0.7rem 1.5rem;
        border-radius: 4px;
        text-decoration: none;
        font-weight: 300;
        transition: all 0.3s ease;
        margin-bottom: 2rem;
        border: none;
        cursor: pointer;
    }
  
 

    /* Blog content */
    .blog-content {
        padding: 80px 0;
    }

    .articles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 30px;
    }

    .blog-card {
        display: flex;
        flex-direction: column;
        border-radius: var(--border-radius);
        overflow: hidden;
        background-color: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        height: 100%;
    }

    .blog-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
    }

    .card-image {
        height: 220px;
        overflow: hidden;
    }

    .image-wrapper {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transition: transform 0.5s ease;
    }

    .blog-card:hover .image-wrapper {
        transform: scale(1.1);
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f1f1f1;
        color: #adb5bd;
    }

    .image-placeholder i {
        font-size: 3rem;
    }

    .card-content {
        padding: 25px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .article-meta {
        display: flex;
        margin-bottom: 15px;
    }

    .article-date {
        font-size: 1.2rem;
        color: black;
    }

    .article-date i {
        margin-right: 5px;
    }

    .article-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 15px;
        color: var(--primary-color);
        line-height: 1.3;
    }

    .article-excerpt {
        color: #6c757d;
        margin-bottom: 25px;
        line-height: 1.6;
        flex-grow: 1;
    }

    .article-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .read-more {
        display: inline-flex;
        align-items: center;
        color: var(--accent-color);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .read-more i {
        margin-left: 8px;
        transition: transform 0.3s ease;
    }

    .read-more:hover {
        color: red;
    }

    .read-more:hover i {
        transform: translateX(5px);
        color: red;
    }

    .admin-tools {
        display: flex;
    }

    .admin-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        margin-left: 8px;
        color: white;
        transition: all 0.3s ease;
    }

    .admin-btn.edit {
        background-color: #3498db;
    }

    .admin-btn.delete {
        background-color: #e74c3c;
    }

    .admin-btn:hover {
        transform: scale(1.1);
    }

    /* Empty state */
    .empty-blog {
        text-align: center;
        padding: 60px 0;
    }

    .empty-icon {
        font-size: 5rem;
        color: #dee2e6;
        margin-bottom: 20px;
    }

    .empty-blog h3 {
        font-size: 1.8rem;
        color: var(--primary-color);
        margin-bottom: 10px;
    }

    .empty-blog p {
        color: #6c757d;
        max-width: 500px;
        margin: 0 auto;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .blog-title {
            font-size: 2.5rem;
        }

        .articles-grid {
            grid-template-columns: 1fr;
        }
    }
</style>