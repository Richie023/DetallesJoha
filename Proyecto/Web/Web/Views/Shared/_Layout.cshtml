    <script src="~/Estilos/js/jquery.zoom.min.js"></script>
    <script src="~/Estilos/js/bootstrap.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
            // Seleccionar todos los títulos de las secciones de filtro
            const filterTitles = document.querySelectorAll('.filter-title');

            // Inicializar todos los acordeones cerrados al cargar la página
            filterTitles.forEach(function (title) {
                const filterContent = title.nextElementSibling;
                filterContent.style.maxHeight = '0';
            });

            // Función para cerrar todos los acordeones excepto el actual
            function closeOtherAccordions(currentTitle) {
                filterTitles.forEach(function (title) {
                    if (title !== currentTitle && title.classList.contains('active')) {
                        // Quitar clase active del título
                        title.classList.remove('active');

                        // Cerrar el contenido
                        const content = title.nextElementSibling;
                        content.style.maxHeight = '0';

                        // Quitar clase active de la sección padre si existe
                        const parentSection = title.parentElement;
                        if (parentSection.classList.contains('filter-section')) {
                            parentSection.classList.remove('active');
                        }
                    }
                });
            }

            // Agregar evento click a cada título
            filterTitles.forEach(function (title) {
                title.addEventListener('click', function (e) {
                    e.preventDefault(); // Prevenir comportamiento predeterminado

                    // Primero cerrar los otros acordeones
                    closeOtherAccordions(this);

                    // Luego alternar el estado del acordeón actual
                    this.classList.toggle('active');

                    // Obtener el contenido asociado a este título
                    const content = this.nextElementSibling;

                    // Obtener la sección padre
                    const parentSection = this.parentElement;

                    // Alternar la visibilidad del contenido y la clase active de la sección
                    if (this.classList.contains('active')) {
                        // Si está activo, mostrar el contenido
                        content.style.maxHeight = content.scrollHeight + 'px';

                        if (parentSection.classList.contains('filter-section')) {
                            parentSection.classList.add('active');
                        }
                    } else {
                        // Si no está activo, ocultar el contenido
                        content.style.maxHeight = '0';

                        if (parentSection.classList.contains('filter-section')) {
                            parentSection.classList.remove('active');
                        }
                    }
                });
            });

            console.log('Script de acordeón exclusivo inicializado con ' + filterTitles.length + ' secciones');
        });</script>
