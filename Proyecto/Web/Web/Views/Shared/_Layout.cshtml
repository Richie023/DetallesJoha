                            @{
                                var carritoProductosRegistrado = Session["CarritoProductos"] as List<Web.Models.CarritoProductoViewModel>;

                                var carritoProductosInvitado = Session["CarritoInvitado"] as List<Web.Models.CarritoProductoViewModel>;

                                var carritoProductos = new List<Web.Models.CarritoProductoViewModel>();

                                if (carritoProductosRegistrado != null && carritoProductosRegistrado.Any())
                                {
                                    carritoProductos = carritoProductosRegistrado;
                                }
