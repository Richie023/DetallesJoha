                                        @(Session["Cantidad"]?.ToString() ?? "0")
                                    </div>
                                </a>
                                <div class="cart-dropdown">
                                    <div class="cart-list">
                                        @if (carritoProductos != null && carritoProductos.Any())
                                        {
                                            foreach (var item in carritoProductos)
                                            {
                                                <div class="product-widget">
                                                    <div class="product-img">
                                                        <img src="@item.ProductoItem.RutaImagen" alt="@item.ProductoItem.NombreProducto">
                                                    </div>
                                                    <div class="product-body">
                                                        <h3 class="product-name">
                                                            <a href="#">@item.ProductoItem.NombreProducto</a>
                                                        </h3>
                                                        <h4 class="product-price">
                                                            <span class="qty">@item.CarritoItem.Cantidad x</span>
                                                            @if (item.ProductoItem.En_promocion)
                                                            {
                                                                <span>₡@item.ProductoItem.PrecioConDescuento.ToString("N2")</span>
                                                            }
                                                            else
                                                            {
                                                                <span>₡@item.CarritoItem.Precio.ToString("N2")</span>
                                                            }
                                                        </h4>
                                                    </div>
                                                    <form action="@Url.Action("EliminarCarritos", "Carrito")" method="post" style="display: inline;">
                                                        @Html.Hidden("ConsecutivoCarrito", item.CarritoItem.ConsecutivoCarrito)
                                                        <button type="submit" class="delete" onclick="return confirm('¿Está seguro que desea eliminar este producto?');">
                                                            <i class="fa fa-close"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="empty-cart">
                                                <p>No hay productos en el carrito</p>
                                            </div>
                                        }
                                    </div>
                                    <div class="cart-summary">
                                        <small>
                                            @(Session["Cantidad"]?.ToString() ?? "0") Productos seleccionados
                                        </small>
                                        <h5>
                                            ₡@(decimal.Parse(Session["SubTotal"]?.ToString() ?? "0").ToString("N2")) + IVA
                                        </h5>
                                    </div>
